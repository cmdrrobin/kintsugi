{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "mcp": {
    "servers": {
      "home-assistant": {
        "type": "remote",
        "url": "{env:HA_URL}",
        "oauth": false,
        "headers": {
          "Authorization": "Bearer {env:HA_TOKEN}"
        },
        "disabled": true
      }
    }
  }
}
